{
  "name": "@insidepics/expo-ml-kit",
  "version": "0.1.0",
  "description": "Google ML Kit on-device image analysis (text, labels, barcodes, poses, objects, entities) for Android and iOS, plus ML Kit face detection on Android.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "test": "vitest run",
    "lint": "eslint src",
    "test:kotlin": "bash android/src/test/run-jvm.sh",
    "typecheck": "tsc --noEmit"
  },
  "author": "INSP LLC",
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "license": "MIT",
  "devDependencies": {
    "expo": "^57.0.31",
    "expo-module-scripts": "^56.0.3",
    "react-native": "^0.86.3"
  },
  "files": [
    "build",
    "src",
    "ios/*.swift",
    "ios/*.podspec",
    "android/build.gradle",
    "android/src/main",
    "plugin/withMlKitSimulator.cjs",
    "app.plugin.cjs",
    "expo-module.config.json",
    "plugin/withMlKitMinSdk.cjs",
    "README.md",
    "LICENSE",
    "!**/__tests__"
  ],
  "react-native": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsidePics/ml.git",
    "directory": "packages/expo-ml-kit"
  },
  "bugs": "https://github.com/InsidePics/ml/issues",
  "homepage": "https://github.com/InsidePics/ml/tree/main/packages/expo-ml-kit#readme",
  "publishConfig": {
    "access": "public"
  }
}
