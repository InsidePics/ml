{
  "name": "expo-image-ml-tools",
  "version": "0.1.0",
  "description": "Model inputs from an Expo image handle: tensors, warps, sharpness and histograms, identical on iOS and Android.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:swift": "swift test",
    "test:kotlin": "bash android/src/test/run-jvm.sh"
  },
  "keywords": [
    "expo",
    "react-native",
    "machine-learning",
    "tensor",
    "image",
    "onnx",
    "tflite",
    "clip",
    "face-alignment",
    "preprocessing",
    "on-device"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsidePics/ml.git",
    "directory": "packages/expo-image-ml-tools"
  },
  "author": "INSP LLC",
  "license": "MIT",
  "files": [
    "build",
    "src",
    "ios/*.swift",
    "ios/*.podspec",
    "android/build.gradle",
    "android/src/main",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "!**/__tests__"
  ],
  "peerDependencies": {
    "expo": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo": "^57.0.31",
    "expo-module-scripts": "^56.0.3",
    "react-native": "^0.86.3"
  },
  "react-native": "src/index.ts",
  "bugs": "https://github.com/InsidePics/ml/issues",
  "homepage": "https://github.com/InsidePics/ml/tree/main/packages/expo-image-ml-tools#readme",
  "publishConfig": {
    "access": "public"
  }
}
