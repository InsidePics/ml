{
  "name": "expo-apple-ml",
  "version": "0.4.1",
  "description": "Apple Intelligence for Expo and React Native: on-device Apple Vision, Foundation Models (the Apple Intelligence LLM), SpeechAnalyzer and Image Playground, from one decoded image.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "prepare": "expo-module prepare",
    "typecheck": "tsc --noEmit",
    "test:swift": "swift test"
  },
  "keywords": [
    "apple-intelligence",
    "apple intelligence",
    "expo",
    "react-native",
    "ios",
    "on-device-ai",
    "on-device",
    "foundation-models",
    "apple-foundation-models",
    "llm",
    "vision",
    "vision-framework",
    "ocr",
    "face-detection",
    "image-classification",
    "barcode",
    "speech-to-text",
    "speech-analyzer",
    "transcription",
    "image-playground",
    "image-generation",
    "machine-learning",
    "coreml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsidePics/ml.git",
    "directory": "packages/expo-apple-ml"
  },
  "bugs": "https://github.com/InsidePics/ml/issues",
  "author": "INSP LLC",
  "license": "MIT",
  "homepage": "https://github.com/InsidePics/ml/tree/main/packages/expo-apple-ml#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "ios/*.swift",
    "ios/*.podspec",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "src",
    "!**/__tests__"
  ],
  "devDependencies": {
    "@types/react": "~19.2.10",
    "expo": "^57.0.31",
    "expo-module-scripts": "^56.0.3",
    "expo-modules-test-core": "^56.0.7",
    "react-native": "0.86.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "react-native": "src/index.ts"
}
